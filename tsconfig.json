{
  // Vérification de tout le dépôt (rendu, processus principal, tests, scripts) ; rien n'est émis ici :
  // Vite compile le rendu, tsconfig.main.json le processus principal, et Node exécute tests et scripts en retirant les types.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "vite/client"],
    "strict": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": { "monaco-esm/*": ["./node_modules/monaco-editor/esm/vs/*"] }
  },
  "include": ["src", "electron", "test", "scripts", "vite.config.ts"]
}
